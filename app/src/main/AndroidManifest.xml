<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="com.example.mytravelapplication">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.MyTravelApplication">

        <activity
                android:name=".UI.AuthActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
                android:name=".UI.MainActivity"
                android:exported="false"
                android:label="Vacation Planner" />

        <activity
                android:name=".UI.VacationListActivity"
                android:exported="false"
                android:label="Vacations" />

        <activity
                android:name=".UI.VacationDetails"
                android:label="Vacation details and excursions"
                android:parentActivityName=".UI.VacationListActivity"
                android:exported="false" />

        <activity
                android:name=".UI.ExcursionDetails"
                android:label="Excursion Details"
                android:parentActivityName=".UI.VacationListActivity"
                android:exported="false" />

        <activity
                android:name=".UI.SearchActivity"
                android:exported="false"
                android:label="Search" />

        <receiver
                android:name=".UI.MyReceiver"
                android:exported="true" />

        <activity android:name=".UI.ReportActivity"
                  android:exported="false" />

    </application>

</manifest>