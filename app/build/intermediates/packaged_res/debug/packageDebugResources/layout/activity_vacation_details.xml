<?xml version="1.0" encoding="UTF-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   tools:context=".UI.VacationDetails">

    <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/excursions_label">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:orientation="vertical">

            <!-- Vacation Title -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/vacation_title" />

                <EditText
                        android:id="@+id/vacation_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="e.g., Bermuda Trip"
                        android:minWidth="150dp" />
            </LinearLayout>

            <!-- Hotel Name -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Hotel" />

                <EditText
                        android:id="@+id/hotel_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="e.g., The Grand Budapest Hotel"
                        android:minWidth="150dp" />
            </LinearLayout>

            <!-- Start Date -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >
                <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Start Date"/>

                <EditText
                        android:id="@+id/start_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 03/15/2026"
                        android:minWidth="150dp" />
            </LinearLayout>

            <!-- End Date -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >
                <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="End Date"/>

                <EditText
                        android:id="@+id/end_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 03/22/2026"
                        android:minWidth="150dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <TextView
            android:id="@+id/excursions_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_marginTop="16dp"
            android:text="Excursions for this vacation"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollView" />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/excursion_recyclerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="15dp"
            app:layout_constraintTop_toBottomOf="@+id/excursions_label"
            app:layout_constraintBottom_toTopOf="@id/navigateToReportButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <!-- Generate Report Button -->
    <Button
            android:id="@+id/navigateToReportButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Generate Report"
            app:layout_constraintBottom_toTopOf="@id/add_excursion_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <TextView
            android:id="@+id/fab_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add excursion"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/add_excursion_button"
            app:layout_constraintTop_toTopOf="@+id/add_excursion_button" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/add_excursion_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:clickable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@android:drawable/ic_input_add"
            android:contentDescription="Add Excursion" />

</androidx.constraintlayout.widget.ConstraintLayout>

